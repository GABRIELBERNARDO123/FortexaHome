# Este arquivo é apenas um modelo. Não use os placeholders como segredos reais.
# Antes de migrar: python -m app.cli.preflight --stage environment
# Após migrar:     python -m app.cli.preflight --stage database
# Antes da Hotmart: python -m app.cli.preflight --stage commercial
# ==== APLICAÇÃO ====
APP_NAME=FortexaHome
ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
# Em produção use uma URL completa com HTTPS.
APP_BASE_URL=http://localhost:3010
LOG_LEVEL=INFO

# ==== BANCO DE DADOS ====
POSTGRES_DB=fortexahome
POSTGRES_USER=fortexa_owner
POSTGRES_PASSWORD=troque_senha_owner
APP_DB_USER=fortexa_app
APP_DB_PASSWORD=troque_senha_app
OUTBOX_DB_USER=fortexa_outbox_worker
# Senha exclusiva, aleatória, sem reutilização; o papel não recebe acesso a outras tabelas.
OUTBOX_DB_PASSWORD=troque_por_segredo_aleatorio_do_worker
DATABASE_URL=postgresql+psycopg://fortexa_app:troque_senha_app@db:5432/fortexahome
MIGRATION_DATABASE_URL=postgresql+psycopg://fortexa_owner:troque_senha_owner@db:5432/fortexahome

# ==== SEGURANÇA ====
# Gere com: openssl rand -hex 32
SECRET_KEY=troque_por_uma_chave_aleatoria_de_64_chars
# Gere com: openssl rand -base64 32
PII_ENCRYPTION_KEY=troque_por_chave_base64_de_32_bytes
# Gere com: openssl rand -hex 32
PII_LOOKUP_KEY=troque_por_chave_hmac_aleatoria
# Gere com: openssl rand -hex 32
LICENSE_HMAC_KEY=troque_por_chave_hmac_de_licencas
SESSION_COOKIE_NAME=fh_session
SESSION_EXPIRE_HOURS=8
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
PASSWORD_RESET_TTL_MINUTES=30
IDEMPOTENCY_RETENTION_HOURS=168
RATE_LIMIT_ENABLED=true
RATE_LIMIT_HMAC_KEY=troque_por_um_segredo_dedicado_de_rate_limit_32_chars
RATE_LIMIT_DB_TIMEOUT_MS=1000
LOGIN_LOCKOUT_ENABLED=true
LOGIN_LOCKOUT_FAILURE_THRESHOLD=5
LOGIN_LOCKOUT_BASE_COOLDOWN_SECONDS=60
LOGIN_LOCKOUT_MAX_COOLDOWN_SECONDS=900
LOGIN_LOCKOUT_INACTIVITY_RESET_SECONDS=86400
LOGIN_LOCKOUT_MAX_TRACKED_FAILURES=32

# ==== CORS ====
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010,http://localhost:5173,http://127.0.0.1:5173
# Somente para o Docker Compose local; configure o peer real em cada ambiente.
TRUSTED_PROXY_IPS=172.31.0.10

# ==== LICENCIAMENTO / DEMONSTRAÇÃO ====
# Em produção: DEMO_MODE=false e ALLOW_PUBLIC_SIGNUP=false
DEMO_MODE=true
ALLOW_PUBLIC_SIGNUP=false
DEMO_LICENSE_CODE=FH-DEMO-2026
DEMO_PRODUCT_SLUG=fortexahome-lifetime
DEMO_PRODUCT_PRICE_CENTS=0

# ==== PAGAMENTOS (integração futura) ====
# Sandbox HMAC é opcional em dev/test; habilite explicitamente com PAYMENT_SANDBOX_ENABLED=true.
PAYMENT_PROVIDER=hmac_sandbox
PAYMENT_WEBHOOK_SECRET=troque_por_segredo_de_webhook
PAYMENT_SANDBOX_ENABLED=false

# ==== HOTMART WEBHOOK 2.0.0 ====
# Ative somente depois de configurar estes valores e cadastrar o produto interno correspondente.
HOTMART_ENABLED=false
HOTMART_WEBHOOK_HOTTOK=
HOTMART_PRODUCT_UCODE=
HOTMART_PRODUCT_SLUG=
# Reconciliação é independente de HOTMART_ENABLED e permanece desabilitada por padrão.
HOTMART_RECONCILIATION_ENABLED=false
HOTMART_RECONCILIATION_CLIENT_ID=
HOTMART_RECONCILIATION_CLIENT_SECRET=
HOTMART_RECONCILIATION_ENVIRONMENT=production
HOTMART_RECONCILIATION_PRODUCT_ID=
HOTMART_RECONCILIATION_TIMEOUT_SECONDS=10
HOTMART_RECONCILIATION_MAX_TRANSACTIONS=25
HOTMART_RECONCILIATION_LOOKBACK_HOURS=72
HOTMART_RECONCILIATION_MAX_ATTEMPTS=3
HOTMART_RECONCILIATION_BACKOFF_BASE_SECONDS=1
HOTMART_RECONCILIATION_REQUEST_INTERVAL_SECONDS=0.25

# ==== E-MAIL ====
# dev: adaptador local sem envio externo; testes substituem o adaptador por um sink controlado
EMAIL_PROVIDER=dev
RESEND_API_KEY=
EMAIL_FROM=FortexaHome <nao-responda@fortexahome.local>
# Gere uma chave aleatória dedicada com pelo menos 32 caracteres.
EMAIL_VERIFICATION_HMAC_KEY=troque_por_uma_chave_hmac_dedicada_de_64_chars
# Worker independente da API HTTP
OUTBOX_POLL_SECONDS=2
OUTBOX_BATCH_SIZE=10
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=900
OUTBOX_DEAD_PAYLOAD_RETENTION_DAYS=30
OUTBOX_STATUS_LOG_SECONDS=60

# ==== TESTES ====
TEST_POSTGRES_DB=fortexahome_test
