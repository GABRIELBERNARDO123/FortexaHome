{
  "name": "fortexahome-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3010",
    "build": "tsc -b && vite build",
    "test": "vitest run",
